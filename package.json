{
	"name": "obsidian-langsoft",
	"version": "1.10.1",
	"description": "Highlight words by how well you know them, keep definitions with the sentence you found them in, and share dictionaries with coworkers.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"test": "vitest run",
		"test:watch": "vitest",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "Ben Kirk",
	"license": "SEE LICENSE IN LICENSE",
	"repository": {
		"type": "git",
		"url": "https://github.com/BenBKirk/Obsidian-Langsoft.git"
	},
	"devDependencies": {
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.44.0",
		"@types/node": "^22.20.7",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"esbuild": "^0.28.2",
		"obsidian": "latest",
		"tslib": "^2.9.1",
		"typescript": "~5.9.3",
		"vitest": "^5.1.2"
	}
}
